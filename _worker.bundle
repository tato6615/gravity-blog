    timeline: {
      background: "#000000",
      tracks: [
        {
          clips: [
            {
              asset: { type: "text", text: productName, font: { color: "#ffffff", size: 40, family: "Montserrat ExtraBold" }, alignment: { horizontal: "center", vertical: "bottom" } },
